# Copia este archivo a .env y ajusta los valores.
# docker compose lee .env automaticamente.

# ===== Base de datos =====
DB_NAME=champions_db
DB_USER=postgres
DB_PASSWORD=postgres

# ===== Fuente de partidos =====
# real -> API publica de football-data.org (REQUIERE TOKEN)
# simulado -> datos ficticios en codigo (para probar sin token)
MATCH_API_MODE=real

# Token gratuito de https://www.football-data.org/client/register
MATCH_API_TOKEN=09e3b3eec76d4fae8c9e54d366043420

# Opcionales (valores por defecto validos para Champions League):
MATCH_API_BASE_URL=https://api.football-data.org/v4
MATCH_API_COMPETITION=CL

# ===== Puerto de la aplicacion en el host =====
APP_PORT=8080
